REGION=ap-southeast-2
ALB_URL=http://REPLACE-with-your-alb-dns-name
TG_ARN=arn:aws:elasticloadbalancing:ap-southeast-2:123456789012:targetgroup/wc-tg/xxxxxxxx
ASG_NAME=wc-asg
DB_ID=wc-db-subnet-group

# Recovery objectives for PASS/FAIL (these are the defaults; optional to set).
# Decide them BEFORE running experiments, then do not change them.
RTO_EC2_S=60
RTO_RDS_S=120
RTO_COMPOUND_S=180
RPO_MAX_LOST=0
